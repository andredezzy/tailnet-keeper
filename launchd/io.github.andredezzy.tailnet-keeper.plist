<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.andredezzy.tailnet-keeper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/tailnet-keeper/tailnet-keeper</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- A run that fails closed while DHCP is still binding has no uplink
       route to place. launchd relaunches it after ThrottleInterval until it
       exits 0, instead of leaving the gap to the next SystemConfiguration
       write or the five-minute timer. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>PathState</key>
    <dict>
      <key>/var/db/tailnet-keeper/vpn-recovery</key>
      <true/>
    </dict>
  </dict>
  <key>WatchPaths</key>
  <array>
    <string>/Library/Preferences/SystemConfiguration</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <!-- Background jobs are throttled to protect the user experience; this
       job restores the user's own connectivity, and the throttle made a cold
       reconciliation five times slower. Standard is the documented fit. -->
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
